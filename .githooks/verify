#!/usr/bin/env bash
# The whole gate, once: format, lints, a release build, every test, the
# window's scripted QA, and the packaging suites. A green run on a clean tree
# is remembered by that tree's hash, so the pre-push hook can skip a suite that
# already passed on exactly what is being pushed.
#
#   .githooks/verify   run the gate (what CI runs), remember a green clean tree
#   .githooks/verify --check [commit]   exit 0 only if that commit's tree
#                      (default HEAD) is remembered green
set -euo pipefail
cd -- "$(git rev-parse --show-toplevel)"

gitdir="$(git rev-parse --git-dir)"
marker="$gitdir/ghost-verified-tree"
tree="$(git rev-parse 'HEAD^{tree}')"

if [[ "${1:-}" == --check ]]; then
  checked="$(git rev-parse "${2:-HEAD}^{tree}")"
  [[ -f "$marker" && "$(cat "$marker")" == "$checked" ]]
  exit
fi

# Save this run's output for the next failure diagnosis. `--check` stays
# above this line so a probe never truncates the log.
exec > >(tee "$gitdir/ghost-verify-last.log") 2>&1

# rustup's own directory when no cargo is on PATH.
command -v cargo >/dev/null || PATH="$HOME/.cargo/bin:$PATH"
cargo fmt --all --check
cargo clippy --workspace --all-targets --locked -- -D warnings
# The release build is what the package ships; the tests run on it.
cargo build --workspace --release --locked
cargo test --workspace --release --locked
# The window's main flows, against a scratch ghostd, on a private display.
bash packages/window/dev/qa.sh
# What the gate checks beyond the workspace, run as the PKGBUILD's check()
# runs it: inside the source archive, so a file the archive loses
# or a link it breaks fails here, not only in the package build. The
# packaging scripts chain the other packaging suites, including the installer
# this repository publishes.
bash packaging/release/test-release-source.sh

# A dirty tree was not what the suite proved, and neither is a HEAD a peer
# moved mid-run; only the clean tree the run started on earns the marker.
if [[ -z "$(git status --porcelain)" && "$(git rev-parse 'HEAD^{tree}')" == "$tree" ]]; then
  printf '%s\n' "$tree" > "$marker"
else
  rm -f "$marker"
  printf 'verify: green, but the working tree is dirty, so HEAD is not marked verified\n' >&2
fi
