[Desktop Entry]
# STUB — the Omarchy webapp wrapper for the Ghost UI.
#
# Omarchy installs web apps with `omarchy-webapp-install <Name> <URL> <icon>`,
# which generates a .desktop entry running the browser in app mode. This file
# is the shape that generator produces, kept in-tree so the daemon ships with
# a launcher the UI package can finish.
#
# TODO(ui): replace PLACEHOLDER_PORT with the port ghostd is configured to
# serve (default 7717) and point Icon= at the real icon once the UI package
# lands. Until then this entry is not installed by anything.
Type=Application
Version=1.0
Name=Ghost
Comment=Your ghost, on your machine
Exec=omarchy-launch-webapp "http://127.0.0.1:7717"
Terminal=false
Icon=ghost
Categories=Network;Chat;
StartupNotify=true
StartupWMClass=Ghost
