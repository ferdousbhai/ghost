[Unit]
Description=Ghost daemon (ghostd)
Documentation=https://github.com/ferdousbhai/ghost
# The desktop helper and headed browser inherit the compositor environment from
# the user manager. Keep the daemon in the graphical session so it cannot start
# early with a permanently incomplete WAYLAND_DISPLAY/Hyprland environment.
PartOf=graphical-session.target
After=graphical-session.target network.target

[Service]
Type=simple
ExecStart=/usr/bin/ghostd
Restart=on-failure
RestartSec=2

# The daemon scrubs inherited provider credentials itself (see env-scrub.ts),
# but a service that never had them is better than one that drops them.
# Do NOT add an EnvironmentFile with API keys here: a ghost's credentials
# belong in %h/Ghosts/<name>/.pi/{models.json,agent.db}.
Environment=GHOSTD_HOST=127.0.0.1

# Local-only service; nothing here should reach outside the user's own files.
# %h is ONE writable bind mount, not per-directory carve-outs: ghost deletion
# renames %h/Ghosts/<name> into %h/.local/share/Trash, and rename(2) across
# two bind mounts fails EXDEV even on the same filesystem. (ProtectHome has no
# "read-write" value — systemd ignores it with a warning; system directories
# stay read-only via ProtectSystem=strict.)
PrivateTmp=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
# Chromium's sandbox needs to create user, PID, network, IPC, and mount
# namespaces. Denying namespace creation makes the dedicated browser abort;
# NoNewPrivileges remains compatible with Chromium's user-namespace sandbox.
LockPersonality=yes
MemoryDenyWriteExecute=no
# PrivateTmp only isolates /tmp and /var/tmp. The user runtime directory stays
# available for the omaharness lock and Wayland/Hyprland sockets.
ReadWritePaths=%h %t
UMask=0077
Slice=session.slice

[Install]
WantedBy=graphical-session.target
