[Unit]
Description=Ghost daemon (ghostd)
Documentation=https://github.com/ferdousbhai/ghost
# The desktop helper inherits the compositor environment from the user manager,
# and the browser relay dials in from the owner's own Chromium session. Keep the
# daemon in the graphical session so it cannot start early with a permanently
# incomplete WAYLAND_DISPLAY/Hyprland environment.
PartOf=graphical-session.target
After=graphical-session.target network.target

[Service]
Type=simple
WorkingDirectory=%h
ExecStart=/usr/bin/ghostd
Restart=on-failure
RestartSec=2
# ghostd stages a 5s graceful drain and a 2s forced settle. Keep a final
# service-manager boundary for providers or sidecars that ignore cancellation.
TimeoutStopSec=10s
KillMode=mixed
SendSIGKILL=yes

# The daemon scrubs inherited provider credentials itself (see env-scrub.ts),
# but a service that never had them is better than one that drops them.
# Do NOT add an EnvironmentFile with API keys here: a ghost's credentials
# belong in its explicit home (%h/ghosts/<name> by default).
Environment=GHOSTD_HOST=127.0.0.1

# Local-only service; nothing here should reach outside the user's own files.
# %h is ONE writable bind mount, not per-directory carve-outs: ghost deletion
# renames a default ghost home into %h/.local/share/Trash, and rename(2) across
# two bind mounts fails EXDEV even on the same filesystem. (ProtectHome has no
# "read-write" value — systemd ignores it with a warning; system directories
# stay read-only via ProtectSystem=strict.)
PrivateTmp=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
# Ghost launches no browser of its own: the relay drives the Chromium the owner
# already started. A ghost may still run `chromium` from its shell when none is
# open — and that child would land in this unit's cgroup, where KillMode=mixed
# and SendSIGKILL would take the owner's browser down with `systemctl --user
# restart ghostd`. The browser tool therefore tells the ghost to start it
# detached (`systemd-run --user --scope`). These properties stay because a
# Chromium that does end up here must still be able to build its sandbox
# namespaces; NoNewPrivileges remains compatible with them.
LockPersonality=yes
MemoryDenyWriteExecute=no
# PrivateTmp only isolates /tmp and /var/tmp. The user runtime directory stays
# available for the omaharness lock and Wayland/Hyprland sockets.
ReadWritePaths=%h %t
UMask=0077
Slice=session.slice

[Install]
WantedBy=graphical-session.target
