#!/bin/sh
set -eu

bun_executable=${GHOST_BUN_EXECUTABLE:-/usr/bin/bun}
case $bun_executable in
  /*) ;;
  *)
    printf '%s\n' 'ghost: GHOST_BUN_EXECUTABLE must be an absolute path' >&2
    exit 127
    ;;
esac
if [ ! -x "$bun_executable" ]; then
  printf 'ghost: Bun is not executable at %s\n' "$bun_executable" >&2
  exit 127
fi

case $0 in
  */*) launcher=$0 ;;
  *) launcher=$(command -v -- "$0") ;;
esac
bin_dir=${launcher%/*}
if [ -f "$bin_dir/../lib/ghost/runtime/ghost.js" ]; then
  bundle=$bin_dir/../lib/ghost/runtime/ghost.js
elif [ -f "$bin_dir/../lib/ghost.js" ]; then
  bundle=$bin_dir/../lib/ghost.js
else
  printf '%s\n' 'ghost: installed runtime bundle is missing' >&2
  exit 127
fi
exec "$bun_executable" "$bundle" "$@"
