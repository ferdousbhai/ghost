{
  "name": "@ghost/daemon",
  "version": "0.6.1",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "ghostd": "./dist/main.js",
    "ghost": "./dist/cli/main.js"
  },
  "files": [
    "dist",
    "contrib"
  ],
  "engines": {
    "bun": ">=1.3.14"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:runtime": "bash scripts/build-runtime.sh",
    "typecheck": "tsc -p tsconfig.json",
    "test": "bun --bun ./node_modules/vitest/vitest.mjs run",
    "dev": "bun src/main.ts"
  },
  "dependencies": {
    "@ghost/extensions": "workspace:*",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/node": "^22.15.0",
    "typescript": "^5.8.3",
    "vitest": "^3.1.4"
  }
}
