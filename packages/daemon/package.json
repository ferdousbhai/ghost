{
  "name": "@ghost/daemon",
  "version": "0.0.1",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "ghostd": "./dist/main.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "contrib"
  ],
  "engines": {
    "bun": ">=1.3.14"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:binary": "bash scripts/build-binary.sh",
    "typecheck": "tsc -p tsconfig.json",
    "test": "bun --bun ./node_modules/vitest/vitest.mjs run",
    "dev": "bun src/main.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.170",
    "@anthropic-ai/sdk": "0.93.0",
    "@earendil-works/pi-agent-core": "0.84.3",
    "@earendil-works/pi-ai": "0.84.3",
    "@earendil-works/pi-coding-agent": "0.84.3",
    "@ghost/extensions": "workspace:*",
    "@modelcontextprotocol/sdk": "1.29.0",
    "ws": "^8.18.0",
    "yaml": "^2.9.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/node": "^22.15.0",
    "@types/ws": "^8.5.13",
    "typebox": "^1.3.7",
    "typescript": "^5.8.3",
    "vitest": "^3.1.4"
  }
}
