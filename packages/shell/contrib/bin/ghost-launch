#!/usr/bin/env bash
# Start the persistent Ghost shell when needed, then open or toggle its HUD.
set -u

action="${1:-open}"
case "$action" in
  open | toggle) ;;
  *)
    printf 'usage: ghost-launch [open|toggle]\n' >&2
    exit 2
    ;;
esac

call_hud() {
  qs -c ghost ipc call ghost "$action"
}

hud_ready() {
  local status
  status="$(qs -c ghost ipc call ghost status 2>/dev/null)"
  [[ "$status" == \{* ]]
}

if hud_ready; then
  call_hud
  exit $?
fi

if systemctl --user cat ghost-shell.service >/dev/null 2>&1; then
  systemctl --user start ghost-shell.service
else
  qs -c ghost --daemonize --no-duplicate
fi

for _ in {1..50}; do
  if hud_ready; then
    call_hud
    exit $?
  fi
  sleep 0.1
done

printf 'ghost-launch: the Ghost shell did not become ready\n' >&2
exit 1
