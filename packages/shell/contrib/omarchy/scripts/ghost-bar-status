#!/usr/bin/env bash
# Ghost indicator for Omarchy's bar, `command` module flavour. No QML, so it
# cannot break when Omarchy changes its widget contract — the trade is a
# subprocess per interval and no animation.
#
# Install:
#   install -Dm755 ghost-bar-status ~/.config/omarchy/bar/scripts/ghost-bar-status
# and add to a bar.layout section in ~/.config/omarchy/shell.json:
#   { "id": "ghost", "type": "command",
#     "exec": "~/.config/omarchy/bar/scripts/ghost-bar-status",
#     "interval": 2, "onClick": "qs -c ghost ipc call ghost toggle" }
#
# Prints Waybar-style JSON: text, tooltip, class.
set -uo pipefail

emit() { printf '{"text":"%s","tooltip":"%s","class":"%s"}\n' "$1" "$2" "$3"; }

status=$(qs -c ghost ipc call ghost status 2>/dev/null) || {
  emit "○ ghost" "ghost shell not running" "offline"
  exit 0
}

read -r ghost streaming activity < <(
  printf '%s' "$status" | python3 -c '
import json, sys
try:
    s = json.load(sys.stdin)
except Exception:
    print("- false -")
    raise SystemExit
print(s.get("ghost") or "-", str(s.get("streaming", False)).lower(), s.get("activity") or "-")
'
)

[[ $ghost == "-" ]] && ghost="no ghost"
[[ $activity == "-" ]] && activity="thinking"

if [[ $streaming == "true" ]]; then
  emit "● ${ghost}" "${ghost} — ${activity}" "active"
else
  emit "○ ${ghost}" "${ghost} — idle" "idle"
fi
