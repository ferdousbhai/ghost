[Unit]
Description=Ghost shell (Quickshell surfaces for ghostd)
Documentation=https://github.com/ferdousbhai/ghost
# graphical-session.target is bound to the compositor, so the shell dies with
# Hyprland and comes back with it rather than lingering as an orphan.
PartOf=graphical-session.target
After=graphical-session.target
# Not Requires=: the shell shows "ghostd is not answering" and retries, which
# is a better failure than refusing to start because the daemon is down.
Wants=ghostd.service
After=ghostd.service

[Service]
Type=simple
WorkingDirectory=%h
# `qs -c ghost` resolves ~/.config/quickshell/ghost/shell.qml.
# --no-duplicate: a second start is a no-op rather than a second HUD.
ExecStart=/usr/bin/qs -c ghost --no-duplicate
ExecReload=/usr/bin/qs -c ghost ipc call ghost refresh
Restart=on-failure
RestartSec=2
# The shell talks to ghostd on loopback and to the compositor; it needs no
# elevated access of its own.
Slice=session.slice

[Install]
WantedBy=graphical-session.target
