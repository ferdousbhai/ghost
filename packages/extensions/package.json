{
  "name": "@ghost/extensions",
  "version": "0.0.1",
  "private": true,
  "license": "Apache-2.0",
  "description": "Ghost's built-in extensions \u2014 the plain-file ghost home as an AI persona \u2014 plus the ghost-home/v2 reader/writer.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "bun": ">=1.3.14"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "bun --bun ./node_modules/vitest/vitest.mjs run",
    "test:browser-integration": "GHOST_BROWSER_INTEGRATION=1 bun --bun ./node_modules/vitest/vitest.mjs run test/browser-playwright-integration.test.ts"
  },
  "dependencies": {
    "fflate": "^0.8.2",
    "playwright-core": "^1.62.1",
    "tldts": "^7.4.11",
    "typebox": "^1.3.7"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/node": "^22.15.3",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "yaml": "^2.9.0"
  }
}
