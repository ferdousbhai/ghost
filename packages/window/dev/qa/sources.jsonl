# The sidebar, a source's list, its search and its reader, the history and its keys, the picture grid, Connect, the
# sidebar toggle and a narrow window, on stand-in.sh's sample data: dev/qa.sh runs it, from the shots' directory.
# A page crossfades in: each shot waits until the page before it is gone.

# A source's list, its newest items first.
{"do":"wait","role":"window","name":"Ask — Ghost","visible":true}
{"do":"select","role":"list-item","name":"Notes"}
{"do":"wait","role":"window","name":"Notes — Ghost","visible":true}
{"do":"wait","role":"list-item","name":"Ferry trip","visible":true}
{"do":"wait","role":"list-item","name":"Packing","visible":true}
{"do":"wait","role":"list-item","name":"Notes","selected":true}
{"do":"wait","role":"button","name":"Back (Alt+Left)","sensitive":true}
{"do":"wait","role":"button","name":"Forward (Alt+Right)","sensitive":false}
{"do":"wait","role":"button","name":"New chat","visible":false}
{"do":"shot","path":"qa-notes.png"}

# The search of it, and an emptied search's way back to the list.
{"do":"type","role":"search-box","name":"Search Notes","text":"boat"}
{"do":"wait","role":"list-item","name":"Ferry trip.md","visible":true,"timeout_ms":30000}
{"do":"wait","role":"list-item","name":"Packing","visible":false}
{"do":"shot","path":"qa-notes-search.png"}
{"do":"key","keys":"<Control>a"}
{"do":"key","keys":"BackSpace"}
{"do":"wait","role":"search-box","name":"Search Notes","text":""}
{"do":"wait","role":"list-item","name":"Packing","visible":true}

# An item in the reader, then back and forward by button and by key.
{"do":"click","role":"list-item","name":"Ferry trip"}
{"do":"wait","role":"window","name":"Ferry trip — Ghost","visible":true}
{"do":"wait","role":"button","name":"Open","visible":true}
{"do":"wait","role":"list-item","name":"Notes","selected":true}
{"do":"wait","role":"search-box","name":"Search Notes","visible":false}
{"do":"shot","path":"qa-reader.png"}
{"do":"click","role":"button","name":"Back (Alt+Left)"}
{"do":"wait","role":"window","name":"Notes — Ghost","visible":true}
{"do":"wait","role":"button","name":"Forward (Alt+Right)","sensitive":true}
{"do":"click","role":"button","name":"Forward (Alt+Right)"}
{"do":"wait","role":"window","name":"Ferry trip — Ghost","visible":true}
{"do":"key","keys":"<Alt>Left"}
{"do":"wait","role":"window","name":"Notes — Ghost","visible":true}
{"do":"key","keys":"<Alt>Left"}
{"do":"wait","role":"window","name":"Ask — Ghost","visible":true}
{"do":"wait","role":"button","name":"Back (Alt+Left)","sensitive":false}
{"do":"key","keys":"<Alt>Right"}
{"do":"wait","role":"window","name":"Notes — Ghost","visible":true}

# A source whose items have pictures: a grid, and a picture in the reader.
{"do":"select","role":"list-item","name":"Photos"}
{"do":"wait","role":"window","name":"Photos — Ghost","visible":true}
{"do":"wait","role":"grid-cell","name":"IMG_0008.MOV · 9 Nov 2026, 06:40","visible":true}
{"do":"wait","role":"search-box","name":"Search Notes","visible":false}
{"do":"shot","path":"qa-photos.png"}
{"do":"click","role":"grid-cell","name":"IMG_0001.HEIC · 11 Nov 2026, 06:40"}
{"do":"wait","role":"window","name":"IMG_0001.HEIC — Ghost","visible":true}
{"do":"wait","role":"button","name":"Open","visible":false}
{"do":"wait","role":"grid-cell","name":"IMG_0008.MOV · 9 Nov 2026, 06:40","visible":false}
{"do":"shot","path":"qa-photo.png"}

# Mail, a source the product's command lists.
{"do":"select","role":"list-item","name":"Mail"}
{"do":"wait","role":"list-item","name":"Your ferry booking","visible":true}
{"do":"wait","role":"list-item","name":"Hotel confirmation","visible":true}

# Connect: each product with its state and its steps (a step opens a terminal, so none is clicked).
{"do":"click","role":"button","name":"Connect your data"}
{"do":"wait","role":"window","name":"Connect — Ghost","visible":true}
{"do":"wait","role":"button","name":"Set up mail","visible":true}
{"do":"wait","role":"button","name":"Add HEY","visible":true}
{"do":"wait","role":"search-box","name":"Search Mail","visible":false}
{"do":"shot","path":"qa-connect.png"}

# Ctrl+B and the header's toggle put the sidebar away and bring it back.
{"do":"key","keys":"<Control>b"}
{"do":"wait","role":"list-item","name":"Notes","visible":false}
{"do":"shot","path":"qa-no-sidebar.png"}
{"do":"click","role":"button","name":"Show or hide the sidebar (Ctrl+B)"}
{"do":"wait","role":"list-item","name":"Notes","visible":true}

# A narrow window: the window has no narrow layout, so it stops at what the sidebar and the page need.
{"do":"select","role":"list-item","name":"Notes"}
{"do":"wait","role":"list-item","name":"Ferry trip","visible":true}
{"do":"resize","width":560,"height":700}
{"do":"wait","role":"list-item","name":"Ferry trip","visible":true}
{"do":"wait","role":"button","name":"Set up mail","visible":false}
{"do":"shot","path":"qa-notes-narrow.png"}
{"do":"state"}
{"do":"quit"}
