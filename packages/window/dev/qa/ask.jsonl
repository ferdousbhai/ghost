# Ask on the stand-in model (`stand_in llama-server`): a question by Enter, its answer,
# New chat, and the asked chat reopened from the list. dev/qa.sh runs it.

{"do":"wait","role":"window","name":"Ghost","visible":true}
{"do":"wait","role":"label","name":"Ask about your notes, mail, chats, files and photos.","visible":true}
{"do":"shot","path":"qa-ask-empty.png"}
# The composer has the keyboard from the start.
{"do":"wait","role":"text-box","focused":true}
{"do":"type","text":"When does the boat leave?"}
{"do":"key","keys":"Return"}
# Nothing of the turn is hidden: its reasoning, its command, and what the command printed.
{"do":"wait","role":"label","name":"The ferry note should say. I will read it.","visible":true,"timeout_ms":30000}
{"do":"wait","role":"label","name":"$ echo 'The boat leaves at nine from the north pier.'","visible":true}
{"do":"wait","role":"label","name":"The boat leaves at nine from the north pier.","visible":true}
{"do":"wait","role":"label","name":"Bring the tickets.","visible":true,"timeout_ms":30000}
{"do":"wait","role":"button","name":"Ask","visible":true}
{"do":"wait","role":"list-item","name":"When does the boat leave","selected":true}
{"do":"shot","path":"qa-ask-answer.png"}

# Shift+Enter is a new line, not a question.
{"do":"type","text":"Bring"}
{"do":"key","keys":"<Shift>Return"}
{"do":"type","text":"what?"}
{"do":"wait","role":"text-box","text":"Bring\nwhat?"}

# New chat starts empty; the asked chat comes back from the list with its transcript.
{"do":"click","role":"button","name":"New chat"}
{"do":"wait","role":"label","name":"Ask about your notes, mail, chats, files and photos.","visible":true}
{"do":"wait","role":"list-item","name":"When does the boat leave","selected":false}
{"do":"wait","role":"text-box","focused":true,"text":"Bring\nwhat?"}
{"do":"select","role":"list-item","name":"When does the boat leave"}
{"do":"wait","role":"label","name":"Bring the tickets.","visible":true}
{"do":"wait","role":"label","name":"The ferry note should say. I will read it.","visible":true}
{"do":"wait","role":"label","name":"The boat leaves at nine from the north pier.","visible":true}
{"do":"wait","role":"label","name":"Ask about your notes, mail, chats, files and photos.","visible":false}
{"do":"shot","path":"qa-ask-reopened.png"}
{"do":"quit"}
