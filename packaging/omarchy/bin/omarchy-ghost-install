#!/bin/bash

# omarchy:summary=Install Ghost and start it for this login
# omarchy:requires-sudo=true

set -e

# The package carries the daemon, the HUD, the CLI, the browser relay, and the
# computer-use helper. Only the two user units need this login's hand.
omarchy-pkg-add ghost

systemctl --user daemon-reload
systemctl --user enable --now ghostd.service ghost-shell.service

omarchy-notification-send -g "Ghost is ready" "Press Super + Ctrl + G to summon it." -t 10000
