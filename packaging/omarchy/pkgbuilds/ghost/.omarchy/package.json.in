{
  "source": "local",
  "release_ring": "fast",
  "upstream": {
    "github": "@@RELEASE_REPOSITORY@@",
    "digests": true,
    "latest_only": true,
    "assets": {
      "x86_64": ["ghost-runtime-{pkgver}-linux-x86_64.tar.zst"]
    },
    "sources": {
      "any": ["https://github.com/@@RELEASE_REPOSITORY@@/releases/download/{tag}/ghost-{pkgver}.tar.gz"]
    }
  }
}
