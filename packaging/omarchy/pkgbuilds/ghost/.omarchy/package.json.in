{
  "source": "local",
  "release_ring": "fast",
  "upstream": {
    "github": "@@RELEASE_REPOSITORY@@",
    "digests": true,
    "latest_only": true,
    "sources": {
      "any": [
        "https://github.com/@@RELEASE_REPOSITORY@@/releases/download/{tag}/ghost-{pkgver}.tar.gz",
        "https://github.com/@@RELEASE_REPOSITORY@@/releases/download/{tag}/ghost-runtime-{pkgver}-linux-any.tar.zst"
      ]
    }
  }
}
