# Maintainer: Ferdous Bhai <https://github.com/ferdousbhai>

pkgname=ghost
pkgver=@@VERSION@@
pkgrel=1
pkgdesc="Owner-local AI persona with memory, tools, and an Omarchy-native desktop shell"
arch=('x86_64')
url="https://github.com/@@RELEASE_REPOSITORY@@"
license=('Apache-2.0')
depends=(
  'at-spi2-core>=2.58'
  'bun>=1.3.14'
  'fd'
  'grim>=1.5'
  'hyprland>=0.56'
  'libnotify>=0.8'
  'libsecret>=0.21'
  'python>=3.11'
  'python-dbus>=1.4'
  'python-gobject>=3.50'
  'python-pillow>=10'
  'qrencode'
  'ripgrep'
  'qt6-5compat>=6.8'
  'quickshell>=0.3'
  'wtype>=0.4'
  'xdg-utils>=1.2'
  'ydotool>=1.0'
)
makedepends=(
  'bun>=1.4.0'
  'desktop-file-utils'
)
checkdepends=(
  'nodejs'
  'python-yaml'
)
optdepends=(
  'basecamp-cli: Basecamp CLI and embedded pi skill'
  'chromium: the browser the relay drives, and the browser-relay smoke test'
  'claude-code>=2.1.251: owner-installed Claude Code harness runtime'
  'gnome-keyring: Secret Service provider for provider and MCP credentials'
  'npm: Firecrawl, Google Workspace, and Agent Skills installers for optional pi integrations'
  'obsidian>=1.12.7: Obsidian CLI access for pi'
  'pnpm: install the optional owner-local Claude Agent SDK boundary'
)
conflicts=('ghost-dev')
options=('!debug' '!strip')
install=ghost.install

_runtime="ghost-runtime-${pkgver}-linux-${CARCH}.tar.zst"
_source_url="https://github.com/@@RELEASE_REPOSITORY@@/releases/download/v${pkgver}/ghost-${pkgver}.tar.gz"
_runtime_url="https://github.com/@@RELEASE_REPOSITORY@@/releases/download/v${pkgver}/${_runtime}"
source=(
  "ghost-${pkgver}.tar.gz::${_source_url}"
  "${_runtime}::${_runtime_url}"
)
noextract=("${_runtime}")
sha256sums=(
  '@@SOURCE_SHA256@@'
  '@@RUNTIME_SHA256@@'
)

_release_identity() {
  local manifest="$1"
  local line key value
  declare -A fields=()

  [[ -f "$manifest" && ! -L "$manifest" ]] || return 1
  while IFS= read -r line || [[ -n "$line" ]]; do
    [[ "$line" == *=* ]] || return 1
    key="${line%%=*}"
    value="${line#*=}"
    case "$key" in
      format|version|source_commit|source_date_epoch) ;;
      *) return 1 ;;
    esac
    [[ ! -v "fields[$key]" ]] || return 1
    fields["$key"]="$value"
  done < "$manifest"

  [[ "${#fields[@]}" -eq 4 ]] || return 1
  [[ "${fields[format]}" == ghost-release-source/v1 ]] || return 1
  [[ "${fields[version]}" == "$pkgver" ]] || return 1
  [[ "${fields[source_commit]}" =~ ^[0-9a-f]{40}$ ]] || return 1
  [[ "${fields[source_date_epoch]}" =~ ^[0-9]+$ ]] || return 1
  printf '%s\t%s\n' \
    "${fields[source_commit]}" "${fields[source_date_epoch]}"
}

prepare() {
  local source_root="$srcdir/ghost-${pkgver}"
  local runtime_parent="$srcdir/runtime"
  local runtime_root="$runtime_parent/ghost-runtime-${pkgver}-linux-${CARCH}"
  local identity source_commit source_date_epoch
  identity="$(_release_identity \
    "$source_root/RELEASE-SOURCE.MANIFEST")" || return 1
  IFS=$'\t' read -r source_commit source_date_epoch <<< "$identity" || return 1
  bash "$source_root/packaging/release/verify-release-source.sh" \
    "$source_root" "$pkgver" "$source_commit" "$source_date_epoch" || return 1
  export SOURCE_DATE_EPOCH="$source_date_epoch"
  install -d -m755 "$runtime_parent"
  find "$runtime_parent" -mindepth 1 -delete
  bsdtar -xf "$srcdir/$_runtime" -C "$runtime_parent" || return 1
  bash "$srcdir/ghost-${pkgver}/packaging/release/verify-runtime-source.sh" \
    "$runtime_root" "$source_root" "$pkgver" "$CARCH" "$source_commit" \
      "$source_date_epoch" || return 1
}

build() {
  # The architecture-specific Bun bundles were built from the frozen lock and
  # verified in prepare(); there is no network build step.
  :
}

check() {
  local source_root="$srcdir/ghost-${pkgver}"
  local runtime_root="$srcdir/runtime/ghost-runtime-${pkgver}-linux-${CARCH}"
  local identity source_commit source_date_epoch
  identity="$(_release_identity \
    "$source_root/RELEASE-SOURCE.MANIFEST")" || return 1
  IFS=$'\t' read -r source_commit source_date_epoch <<< "$identity" || return 1
  bash "$source_root/packaging/arch/test-check-dependencies.sh" || return 1
  bash "$source_root/packaging/release/verify-runtime-source.sh" \
    "$runtime_root" "$source_root" "$pkgver" "$CARCH" "$source_commit" \
      "$source_date_epoch" || return 1
  desktop-file-validate \
    "$source_root/packages/shell/contrib/ghost.desktop" || return 1
  python -m json.tool \
    "$source_root/packages/chromium-extension/extension/manifest.json" \
    >/dev/null || return 1
}

package() {
  local source_root="$srcdir/ghost-${pkgver}"
  local runtime_root="$srcdir/runtime/ghost-runtime-${pkgver}-linux-${CARCH}"
  bash "$source_root/packaging/release/install-payload.sh" \
    "$source_root" "$runtime_root" "$pkgdir" "$pkgname"
}
