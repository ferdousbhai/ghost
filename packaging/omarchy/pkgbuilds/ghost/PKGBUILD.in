# Maintainer: Ferdous Bhai <https://github.com/ferdousbhai>

pkgname=ghost
pkgver=@@VERSION@@
pkgrel=1
pkgdesc="Your own data and your ghost, answered by a model on your machine"
# The window is native code.
arch=('x86_64' 'aarch64')
url="https://github.com/@@RELEASE_REPOSITORY@@"
license=('Apache-2.0')
depends=(
  'bun>=1.3.14'
  'glib2'
  'gtk4>=4.14'
  'hyprland>=0.56'
  'jq'
  'systemd'
  'xdg-utils>=1.2'
)
makedepends=(
  'bun>=1.4.0'
  'cargo'
  'desktop-file-utils'
  'pnpm>=10.12.2'
)
checkdepends=(
  'jq'
  'nodejs'
  'ripgrep'
)
optdepends=(
  'chromium: optional signed-in browser automation with agent-browser'
)
# 0.11.9 and earlier split the daemon out as ghost-runtime.
conflicts=(ghost-dev ghost-runtime)
replaces=(ghost-runtime)
install=ghost.install
options=('!debug' '!lto' '!strip')

# Omarchy's sync-upstream follows the GitHub release named in
# .omarchy/package.json and rewrites pkgver and the checksum.
source=("ghost-${pkgver}.tar.gz::https://github.com/@@RELEASE_REPOSITORY@@/releases/download/v${pkgver}/ghost-${pkgver}.tar.gz")
sha256sums=('@@SOURCE_SHA256@@')

prepare() {
  cd -- "$srcdir/ghost-${pkgver}"
  # Everything the build downloads, it downloads here, from the two lockfiles.
  bash packaging/release/prepare-pnpm-engine.sh .
  pnpm install --frozen-lockfile
  cargo fetch --locked --manifest-path packages/window/Cargo.toml
}

build() {
  cd -- "$srcdir/ghost-${pkgver}"
  # The daemon and CLI as Bun bundles, then the window. No build or home
  # folder in the window's panic messages.
  pnpm --filter @ghost/daemon build:runtime
  RUSTFLAGS="${RUSTFLAGS:-} --remap-path-prefix=$srcdir=/build --remap-path-prefix=${CARGO_HOME:-$HOME/.cargo}=/cargo" \
    cargo build --frozen --release --manifest-path packages/window/Cargo.toml
}

check() {
  cd -- "$srcdir/ghost-${pkgver}"
  bash packaging/arch/test-check-dependencies.sh
  cargo test --frozen --release --manifest-path packages/window/Cargo.toml
}

package() {
  cd -- "$srcdir/ghost-${pkgver}"
  bash packaging/release/install-payload.sh \
    . packages/daemon/dist/runtime "$pkgdir" "$pkgname" \
    packages/window/target/release/ghost-window
}
