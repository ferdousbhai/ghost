# Maintainer: Ferdous Bhai <https://github.com/ferdousbhai>

pkgname=ghost-ai
pkgver=@@VERSION@@
pkgrel=1
pkgdesc="Owner-local AI persona with memory, tools, and an Omarchy-native desktop shell"
arch=('x86_64')
url="https://github.com/ferdousbhai/ghost"
license=('Apache-2.0')
depends=(
  'at-spi2-core>=2.58'
  'grim>=1.5'
  'hyprland>=0.56'
  'libnotify>=0.8'
  'libsecret>=0.21'
  'python>=3.11'
  'python-dbus>=1.4'
  'python-gobject>=3.50'
  'python-pillow>=10'
  'qrencode'
  'qt6-5compat>=6.8'
  'quickshell>=0.3'
  'wtype>=0.4'
  'xdg-utils>=1.2'
  'ydotool>=1.0'
)
makedepends=(
  'bun>=1.3.14'
  'desktop-file-utils'
)
checkdepends=(
  'nodejs'
  'python-yaml'
  'ripgrep'
)
optdepends=(
  'basecamp-cli: Basecamp CLI and embedded pi skill'
  'chromium: the browser the relay drives, and the browser-relay smoke test'
  'claude-code: Claude Code plan runtime'
  'gnome-keyring: Secret Service provider for provider and MCP credentials'
  'npm: Firecrawl, Google Workspace, and Agent Skills installers for optional pi integrations'
  'obsidian>=1.12.7: Obsidian CLI access for pi'
)
conflicts=('ghost-ai-git')
options=('!debug' '!strip')
install=ghost-ai.install

_source_commit=@@SOURCE_COMMIT@@
_source_date_epoch=@@SOURCE_DATE_EPOCH@@
export SOURCE_DATE_EPOCH="$_source_date_epoch"
_runtime="ghost-runtime-${pkgver}-linux-${CARCH}.tar.zst"
_source_url="${GHOST_RELEASE_SOURCE_URL:-https://github.com/ferdousbhai/ghost/releases/download/v${pkgver}/ghost-${pkgver}.tar.gz}"
_runtime_url="${GHOST_RELEASE_RUNTIME_URL:-https://github.com/ferdousbhai/ghost/releases/download/v${pkgver}/${_runtime}}"
source=(
  "ghost-${pkgver}.tar.gz::${_source_url}"
  "${_runtime}::${_runtime_url}"
)
noextract=("${_runtime}")
sha256sums=(
  '@@SOURCE_SHA256@@'
  '@@RUNTIME_SHA256@@'
)

prepare() {
  local source_root="$srcdir/ghost-${pkgver}"
  local runtime_parent="$srcdir/runtime"
  local runtime_root="$runtime_parent/ghost-runtime-${pkgver}-linux-${CARCH}"
  bash "$source_root/packaging/release/verify-release-source.sh" \
    "$source_root" "$pkgver" "$_source_commit" "$_source_date_epoch"
  install -d -m755 "$runtime_parent"
  find "$runtime_parent" -mindepth 1 -delete
  bsdtar -xf "$srcdir/$_runtime" -C "$runtime_parent"
  bash "$srcdir/ghost-${pkgver}/packaging/release/verify-runtime-source.sh" \
    "$runtime_root" "$source_root" "$pkgver" "$CARCH" "$_source_commit" \
      "$_source_date_epoch"
}

build() {
  # The architecture-specific runtime source is already compiled from the
  # frozen lock and verified in prepare(); there is no network build step.
  :
}

check() {
  local source_root="$srcdir/ghost-${pkgver}"
  local runtime_root="$srcdir/runtime/ghost-runtime-${pkgver}-linux-${CARCH}"
  bash "$source_root/packaging/arch/test-check-dependencies.sh"
  bash "$source_root/packaging/release/verify-runtime-source.sh" \
    "$runtime_root" "$source_root" "$pkgver" "$CARCH" "$_source_commit" \
      "$_source_date_epoch"
  desktop-file-validate "$source_root/packages/shell/contrib/ghost.desktop"
  python -m json.tool \
    "$source_root/packages/chromium-extension/extension/manifest.json" >/dev/null
}

package() {
  local source_root="$srcdir/ghost-${pkgver}"
  local runtime_root="$srcdir/runtime/ghost-runtime-${pkgver}-linux-${CARCH}"
  bash "$source_root/packaging/release/install-payload.sh" \
    "$source_root" "$runtime_root/bin/ghostd" "$runtime_root/bin/ghost" \
      "$pkgdir" "$pkgname"
}
