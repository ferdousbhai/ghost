{
  "format": "ghost-public-candidate-interface/v1",
  "environment": {
    "GHOST_RELEASE_REPOSITORY": {
      "required": true,
      "shape": "owner/repository",
      "purpose": "Public repository that owns immutable release downloads"
    }
  },
  "helper": "packaging/release/public-candidate.py",
  "ci_wrapper": {
    "script": "packaging/release/ci-build-stable.sh",
    "output": "$GHOST_CI_RELEASE_OUT/public-candidate",
    "required_environment": [
      "GHOST_RELEASE_REPOSITORY",
      "GITHUB_REPOSITORY",
      "GITHUB_WORKFLOW_REF",
      "GITHUB_RUN_ID",
      "GITHUB_RUN_ATTEMPT"
    ],
    "optional_newline_rows": {
      "GHOST_RELEASE_ACTION_METADATA": "OWNER/REPOSITORY=40_HEX_SHA",
      "GHOST_RELEASE_CONTAINER_METADATA": "NAME=IMAGE_IDENTITY"
    }
  },
  "commands": {
    "create": {
      "required_identity_options": [
        "--version",
        "--source-tag",
        "--source-commit",
        "--source-date-epoch",
        "--workflow-repository",
        "--workflow-ref",
        "--run-id",
        "--run-attempt"
      ],
      "required_artifact_options": [
        "--source-archive",
        "--runtime-archive",
        "--runtime-checksum"
      ],
      "optional_artifact_options": [
        "--checksum-signature"
      ],
      "repeatable_options": [
        "--build-tool NAME=VERSION",
        "--action OWNER/REPOSITORY=40_HEX_SHA",
        "--container NAME=IMAGE_IDENTITY"
      ],
      "required_build_tools": [
        "bun",
        "git",
        "makepkg",
        "pnpm",
        "python",
        "zstd"
      ]
    },
    "verify": {
      "required_identity_options": [
        "--version",
        "--source-tag",
        "--source-commit",
        "--source-date-epoch",
        "--workflow-repository",
        "--workflow-ref",
        "--run-id",
        "--run-attempt"
      ]
    }
  },
  "inventory": {
    "checksummed": [
      "ghost-<version>.tar.gz",
      "ghost-runtime-<version>-linux-x86_64.tar.zst",
      "ghost-runtime-<version>-linux-x86_64.tar.zst.sha256",
      "RELEASE-METADATA.json"
    ],
    "manifest": "SHA256SUMS",
    "optional_detached_signature": "SHA256SUMS.sig",
    "forbidden": ["*.pkg.tar.zst", "ghost-dev-*"]
  },
  "metadata_format": "ghost-release-candidate/v1",
  "success_output": "Verified public release candidate: <directory>"
}
