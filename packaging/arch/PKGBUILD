# Maintainer: Ferdous Bhai <https://github.com/ferdousbhai>

pkgname=ghost-ai-git
pkgver=0.0.1.r100.g0c04ce7
pkgrel=1
pkgdesc="Owner-local AI persona with memory, tools, and an Omarchy-native desktop shell"
arch=('x86_64')
url="https://github.com/ferdousbhai/ghost"
license=('Apache-2.0')
depends=(
  'at-spi2-core>=2.58'
  'bun>=1.3.14'
  'grim>=1.5'
  'hyprland>=0.56'
  'libnotify>=0.8'
  'python>=3.11'
  'python-dbus>=1.4'
  'python-gobject>=3.50'
  'python-pillow>=10'
  'qt6-5compat>=6.8'
  'quickshell>=0.3'
  'wtype>=0.4'
  'xdg-utils>=1.2'
  'ydotool>=1.0'
)
makedepends=(
  'desktop-file-utils'
  'git'
  'pnpm>=10.12.2'
  'uv'
)
checkdepends=(
  'nodejs'
  'ripgrep'
)
optdepends=(
  'chromium: dedicated Ghost browser and browser-relay smoke test'
  'claude-code: Claude Code plan runtime'
)
provides=('ghost-ai')
conflicts=('ghost-ai')
options=('!debug' '!strip')
install=ghost-ai-git.install
source=("ghost::git+${GHOST_SOURCE_REPO:-https://github.com/ferdousbhai/ghost.git}#${GHOST_SOURCE_REF:-branch=master}")
sha256sums=('SKIP')

_install_tree() {
  local source_dir="$1"
  local destination_dir="$2"
  local directory file relative mode

  install -d -m755 -o root -g root "$destination_dir"
  while IFS= read -r -d '' directory; do
    relative="${directory#"$source_dir"/}"
    install -d -m755 -o root -g root "$destination_dir/$relative"
  done < <(find "$source_dir" -mindepth 1 -type d -print0)
  while IFS= read -r -d '' file; do
    relative="${file#"$source_dir"/}"
    mode=644
    [[ -x "$file" ]] && mode=755
    install -Dm"$mode" -o root -g root "$file" "$destination_dir/$relative"
  done < <(find "$source_dir" -type f -print0)
}

_unlink_references_to() {
  local tree="$1"
  local target="$2"
  local link resolved

  while IFS= read -r -d '' link; do
    resolved="$(realpath -m "$link")"
    case "$resolved" in
      "$target"|"$target"/*) unlink "$link" ;;
    esac
  done < <(find "$tree" -type l -print0)
}

_remove_tree() {
  local target="$1"
  [[ -e "$target" ]] || return 0
  find "$target" -depth -delete
}

_prune_optional_package() {
  local daemon_dir="$1"
  local pattern="$2"
  local package_dir

  while IFS= read -r -d '' package_dir; do
    _unlink_references_to "$daemon_dir" "$package_dir"
    _remove_tree "$package_dir"
  done < <(find "$daemon_dir/node_modules/.pnpm" -mindepth 1 -maxdepth 1 \
    -type d -name "$pattern" -print0)
}

pkgver() {
  cd -- "$srcdir/ghost"

  local version revision commit
  version="$(bun -e 'const p = await Bun.file("package.json").json(); process.stdout.write(p.version)')"
  revision="$(git rev-list --count HEAD)"
  commit="$(git rev-parse --short=7 HEAD)"
  printf '%s.r%s.g%s\n' "$version" "$revision" "$commit"
}

build() {
  cd -- "$srcdir/ghost"

  bash packaging/release/prepare-pnpm-engine.sh .
  ONNXRUNTIME_NODE_INSTALL=skip pnpm install --frozen-lockfile
  pnpm build
}

check() {
  cd -- "$srcdir/ghost"

  bash packaging/arch/test-check-dependencies.sh
  GHOST_ARCH_CHECK_RUNTIME_TEST_ROOT="$srcdir" \
    bash packaging/arch/test-check-runtime.sh packaging/arch/PKGBUILD
  GHOST_OFFLINE_DEPLOY_TEST_ROOT="$srcdir" \
    bash packaging/release/test-offline-deploy.sh "$srcdir/ghost"
  pnpm test
  pnpm typecheck
  pnpm lint
  (
    cd -- "$srcdir/ghost/packages/desktop-helper"
    bash "$srcdir/ghost/packaging/arch/run-with-check-runtime.sh" "$srcdir" \
      uv run --frozen pytest -m 'not live'
  )
}

package() {
  cd -- "$srcdir/ghost"

  local appdir="$pkgdir/usr/lib/ghost"
  local sharedir="$pkgdir/usr/share/ghost"

  # Assemble from the frozen shared lock without registry metadata. The helper
  # gives pnpm a fresh cache/home and dead network, then makes the injected
  # workspace payload self-contained and checkout-path independent.
  bash packaging/release/deploy-runtime.sh . "$appdir/daemon"

  # Arch is x86_64 glibc. Remove optional musl payloads and non-Linux ONNX
  # libraries, first unlinking only references into the exact discarded tree.
  _prune_optional_package "$appdir/daemon" '@anthropic-ai+claude-agent-sdk-linux-x64-musl@*'
  _prune_optional_package "$appdir/daemon" '@img+sharp-libvips-linuxmusl-x64@*'
  _prune_optional_package "$appdir/daemon" '@img+sharp-linuxmusl-x64@*'
  _prune_optional_package "$appdir/daemon" 'lightningcss-linux-x64-musl@*'
  for foreign_dir in \
    "$appdir/daemon/node_modules/.pnpm/onnxruntime-node@"*/node_modules/onnxruntime-node/bin/napi-v6/linux/arm64 \
    "$appdir/daemon/node_modules/.pnpm/onnxruntime-node@"*/node_modules/onnxruntime-node/bin/napi-v6/darwin \
    "$appdir/daemon/node_modules/.pnpm/onnxruntime-node@"*/node_modules/onnxruntime-node/bin/napi-v6/win32; do
    [[ -e "$foreign_dir" ]] || continue
    _unlink_references_to "$appdir/daemon" "$foreign_dir"
    _remove_tree "$foreign_dir"
  done
  if find "$appdir/daemon/node_modules/.pnpm" -path \
    '*/onnxruntime-node/bin/napi-v6/linux/x64/libonnxruntime_providers_*.so' \
    -print -quit | grep -q .; then
    printf 'runtime contains non-frozen optional ONNX CUDA provider libraries\n' >&2
    exit 1
  fi

  install -Dm755 packaging/arch/ghostd "$pkgdir/usr/bin/ghostd"
  install -Dm755 packaging/arch/ghost-desktop-helper \
    "$pkgdir/usr/bin/ghost-desktop-helper"
  install -Dm755 packages/shell/contrib/bin/ghost-launch \
    "$pkgdir/usr/bin/ghost-launch"

  # Keep the helper and its vendored harness in a private import directory.
  # This deliberately avoids installing `omaharness` as a global Python package.
  while IFS= read -r -d '' file; do
    install -Dm644 "$file" "$appdir/desktop-helper/${file#packages/desktop-helper/src/}"
  done < <(find packages/desktop-helper/src -type f \
    \( -name '*.py' -o -name 'LICENSE' \) -print0)

  _install_tree packages/shell/qml "$sharedir/quickshell"
  install -d -m755 -o root -g root "$pkgdir/etc/xdg/quickshell"
  ln -s /usr/share/ghost/quickshell "$pkgdir/etc/xdg/quickshell/ghost"

  _install_tree packages/chromium-extension/extension "$sharedir/chromium-extension"

  install -Dm644 packages/daemon/contrib/ghostd.service \
    "$pkgdir/usr/lib/systemd/user/ghostd.service"
  install -Dm644 packages/shell/contrib/systemd/ghost-shell.service \
    "$pkgdir/usr/lib/systemd/user/ghost-shell.service"
  install -Dm644 packages/shell/contrib/ghost.desktop \
    "$pkgdir/usr/share/applications/ghost.desktop"
  install -Dm755 packaging/arch/service-browser-smoke.sh \
    "$pkgdir/usr/lib/ghost/package-smoke/service-browser-smoke.sh"
  install -Dm755 packaging/release/smoke-native-runtime.sh \
    "$pkgdir/usr/lib/ghost/package-smoke/native-runtime-smoke.sh"

  _install_tree packages/shell/contrib "$pkgdir/usr/share/doc/ghost/shell-contrib"
  install -Dm644 packaging/arch/README.md "$pkgdir/usr/share/doc/ghost/ARCH.md"
  install -Dm644 README.md "$pkgdir/usr/share/doc/ghost/README.md"
  install -Dm644 CONTRACTS.md "$pkgdir/usr/share/doc/ghost/CONTRACTS.md"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 THIRD_PARTY_NOTICES.md \
    "$pkgdir/usr/share/licenses/$pkgname/THIRD_PARTY_NOTICES.md"

  # Package-manager stores and archive copies can retain a builder's numeric
  # owner. Normalize the complete payload under fakeroot and reject unsafe modes.
  chown -hR 0:0 "$pkgdir"
  find "$pkgdir" \( -type f -o -type d \) -exec chmod go-w {} +

  bash packaging/arch/smoke.sh "$pkgdir"
}
