# Maintainer: Ferdous Bhai <https://github.com/ferdousbhai>

pkgname=ghost-dev
# Regenerated by pkgver() during every build; the committed value is not
# authoritative and is expected to lag HEAD.
pkgver=0.0.1.r100.g0c04ce7
pkgrel=1
pkgdesc="An orchestration layer for all your agent harnesses"
# The window is native code.
arch=('x86_64' 'aarch64')
url="https://github.com/ferdousbhai/ghost"
license=('Apache-2.0')
depends=(
  'bun>=1.3.14'
  'glib2'
  'gtk4>=4.14'
  'hyprland>=0.56'
  'jq'
  'systemd'
  'xdg-utils>=1.2'
)
makedepends=(
  'bun>=1.4.0'
  'cargo'
  'desktop-file-utils'
  'git'
  'pnpm>=10.12.2'
)
checkdepends=(
  'jq'
  'nodejs'
  'ripgrep'
)
optdepends=(
  'chromium: optional signed-in browser automation with agent-browser'
)
provides=("ghost=$pkgver-$pkgrel")
conflicts=(ghost ghost-runtime ghost-runtime-dev)
replaces=(ghost-runtime-dev)
install=ghost-dev.install
options=('!debug' '!lto' '!strip')
source=("ghost::git+${GHOST_SOURCE_REPO:-https://github.com/ferdousbhai/ghost.git}#${GHOST_SOURCE_REF:-branch=master}")
sha256sums=('SKIP')

pkgver() {
  cd -- "$srcdir/ghost"

  local version revision commit
  version="$(bun -e 'const p = await Bun.file("package.json").json(); process.stdout.write(p.version)')"
  revision="$(git rev-list --count HEAD)"
  commit="$(git rev-parse --short=7 HEAD)"
  printf '%s.r%s.g%s\n' "$version" "$revision" "$commit"
}

build() {
  cd -- "$srcdir/ghost"

  bash packaging/release/prepare-pnpm-engine.sh .
  pnpm install --frozen-lockfile
  # The window (packages/window) is cargo's; no build or home folder in its panic messages.
  export RUSTFLAGS="${RUSTFLAGS:-} --remap-path-prefix=$srcdir=/build --remap-path-prefix=${CARGO_HOME:-$HOME/.cargo}=/cargo"
  pnpm build
  pnpm --filter @ghost/daemon build:runtime
}

check() {
  cd -- "$srcdir/ghost"

  # Builds the sanitized source archive and runs the packaging checks
  # (test-check-dependencies.sh) inside it.
  bash packaging/release/test-release-source.sh
  # The window's scripted QA needs a window built with its `qa` feature, which a package build does not make;
  # `pnpm verify` runs it.
  GHOST_WINDOW_QA=0 pnpm test
  bun test scripts
  pnpm typecheck
  pnpm lint
}

package() {
  cd -- "$srcdir/ghost"
  bash packaging/release/install-payload.sh \
    . packages/daemon/dist/runtime "$pkgdir" "$pkgname" \
    packages/window/target/release/ghost-window
}
