@@ -0,0 +1,21 @@
+import { Settings } from "../config/settings";
+
+const fallbackSettings = Settings.isolated();
+const settingIdentities = new WeakMap<Settings, number>();
+let nextSettingIdentity = 1;
+
+/** Resolve eval settings without reading ambient process/project configuration. */
+export function resolveEvalSettings(settings?: Settings): Settings {
+	return settings ?? fallbackSettings;
+}
+
+/** Stable process-local identity used to partition eval probe/kernel caches. */
+export function evalSettingsIdentity(settings?: Settings): number {
+	const resolved = resolveEvalSettings(settings);
+	let identity = settingIdentities.get(resolved);
+	if (identity === undefined) {
+		identity = nextSettingIdentity++;
+		settingIdentities.set(resolved, identity);
+	}
+	return identity;
+}
